{
  "manifest_version": 3,
  "name": "Muse Workspace Tools",
  "version": "0.2.1",
  "description": "Workspace-aware tabs, protected grouping, captures and link collections.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Muse Workspace Tools"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": ["https://accounts.google.com/*"],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
